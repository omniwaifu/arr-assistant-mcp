# Copy to a local ignored .env file if your launcher supports it.
# Never commit real API keys.

# Radarr Configuration
RADARR_URL=http://your-arr-host:7878
RADARR_API_KEY=your-radarr-api-key-here

# Sonarr Configuration
SONARR_URL=http://your-arr-host:8989
SONARR_API_KEY=your-sonarr-api-key-here

# Optional Settings
QUALITY_PROFILE_ID=1
# Root folders (if not set, will auto-detect from server)
RADARR_ROOT_FOLDER=/movies
SONARR_ROOT_FOLDER=/tv

# HTTP server (source runs default to stdio; the Docker image defaults to http)
ARR_MCP_TRANSPORT=http
ARR_MCP_HOST=127.0.0.1
ARR_MCP_PORT=8000
# Required for HTTP: generate with `openssl rand -hex 32`. Keep this separate from Arr API keys.
ARR_MCP_TOKEN=
# Compose publishes on loopback by default. Set your server's LAN IP for direct LAN access.
ARR_MCP_BIND_ADDRESS=127.0.0.1
# Extra client-facing hostnames/IPs, comma-separated, without schemes or paths.
# Example: media-server.local,192.168.1.50,mcp.example.com
ARR_MCP_ALLOWED_HOSTS=
